{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btc-strategy/schemas/phase2/v2/artifact.schema.json",
  "title": "Phase2 Artifact",
  "description": "Metadata for a terminal artifact in the Phase-2 acceptance harness.",
  "type": "object",
  "required": ["artifact_id", "sha256"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identity of the artifact."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 of the artifact bytes."
    }
  },
  "additionalProperties": false
}
